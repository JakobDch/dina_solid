# Frontend configuration (build time).
#
# Copy this file to `.env.local` for local development.
#
# For a pre-built production image, prefer overriding public/config.js at
# runtime instead: Vite inlines these values when the bundle is built, so
# changing them here would require a rebuild.

# Backend API of this project.
VITE_DINA_BACKEND_URL=http://localhost:8002

# Solid OIDC issuer offered as the primary login option.
VITE_SOLID_OIDC_ISSUER=https://solid-community-server.tmdt.info

# Additional login providers, comma-separated as "Label|https://url".
VITE_SOLID_PROVIDERS=solidcommunity.net|https://solidcommunity.net,Inrupt Pod Spaces|https://login.inrupt.com

# Web application of the dataspace, used for outbound links.
VITE_DATASPACE_UI_URL=https://solid-dataspace-dace.tmdt.info
