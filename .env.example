# =============================================================================
# DINa backend configuration
#
# Copy this file to `.env` and adjust the values.
# =============================================================================

# --- Solid dataspace ---------------------------------------------------------
# To point this application at a DIFFERENT dataspace you normally only need to
# change the next two variables. Every catalog URL is derived from them.

# Pod / storage server: where the RDF data and catalog containers live.
SOLID_POD_BASE_URL=https://solid-community-server.tmdt.info

# Dataspace slug. Appears as a path segment in both the catalog container
# ({pod}/{slug}/catalog/ds/) and the federation registry
# ({pod}/semanticdatacatalog/public/{slug}/).
DATASPACE_SLUG=dace

# Solid OIDC issuer used for login. Defaults to SOLID_POD_BASE_URL; set it
# separately if users authenticate with a pod hosted elsewhere.
# SOLID_OIDC_ISSUER=https://solid-community-server.tmdt.info

# Web application of the dataspace. Used for outbound links only - it serves
# HTML and is never queried as RDF.
DATASPACE_UI_URL=https://solid-dataspace-dace.tmdt.info

# --- Derived catalog URLs (override only for non-standard pod layouts) --------
# CATALOG_API_URL=https://solid-community-server.tmdt.info/dace/catalog/ds/
# FEDERATION_REGISTRY_URL=https://solid-community-server.tmdt.info/semanticdatacatalog/public/dace/
# CATALOG_CONTAINER_PATH=catalog/ds/
# Query only the configured catalog instead of the whole federation:
# CATALOG_USE_FEDERATION=true
# Per-pod timeout during federation discovery, in seconds:
# FEDERATION_TIMEOUT_SECONDS=5
# Host substitutions for pod URLs read from the registry. Registries outlive the
# deployments they describe: when a pod server is renamed, the WebIDs already
# recorded keep pointing at the old host. Format: "old.example=new.example".
# POD_HOST_REWRITES=old.example=new.example

# --- Language models (set the one you intend to use) -------------------------
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# FIREWORKS_API_KEY=
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# REMOTE_OLLAMA_LLAMA31_70B_BASE_URL=http://your-ollama-server:11434

# --- Infrastructure ----------------------------------------------------------
# Postgres credentials used by docker-compose.
# POSTGRES_USER=app
# POSTGRES_PASSWORD=app
# POSTGRES_DB=app

# Browser origins allowed to call the API, comma-separated.
# DINA_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Cache for result sets too large to keep in the session context.
# REDIS_URL=redis://redis:6379/2

# --- Catalog tuning (optional) -----------------------------------------------
# CATALOG_SEARCH_TOP_K=20
# CATALOG_AGENT_MAX_STEPS=15
# MEMORY_CACHE_SIZE=50
# DISK_CACHE_TTL_SECONDS=86400
# DISK_CACHE_MAX_SIZE_MB=500
